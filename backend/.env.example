# ─────────────────────────────────────────────────────────────────
# .env.example — Copy to .env and fill in real values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Flask core ────────────────────────────────────────────────────
FLASK_ENV=development

# REQUIRED — minimum 64-char random string. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-64-char-hex

# ── Admin authentication ──────────────────────────────────────────
# REQUIRED — sent as header: X-Admin-Token: <value>
# Minimum 32-char random string. Generate with:
#   python -c "import secrets; print(secrets.token_hex(24))"
ADMIN_TOKEN=replace-with-48-char-hex

# ── Database ──────────────────────────────────────────────────────
# Dev:  sqlite:///app.db  (relative to backend/)
# Prod: sqlite:////absolute/path/app.db  OR  postgresql://user:pw@host/db
DATABASE_URL=sqlite:///app.db

# ── File uploads ──────────────────────────────────────────────────
MAX_UPLOAD_MB=10

# ── CORS ─────────────────────────────────────────────────────────
# Dev:  http://localhost:5173
# Prod: https://yourdomain.com  (no trailing slash; comma-separated for multiple)
ALLOWED_ORIGINS=http://localhost:5173

# ── Logging ───────────────────────────────────────────────────────
# One of: DEBUG INFO WARNING ERROR
LOG_LEVEL=INFO

# ── AI/RAG (Phase 4) ─────────────────────────────────────────────
# Optional — if set, SecureAI uses GPT-4o-mini for generated answers
# Leave blank to use BM25 retrieval only (no API key required)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ── RAG tuning ───────────────────────────────────────────────────
# Number of documents to retrieve (1-10)
RAG_TOP_K=5
